# Переменные сайта. Незаполненные строки удалить или закомментировать:
# пустое значение («KEY=») считается ошибкой настройки, и сайт не запустится.

# --- заполняются при настройке сервера (server-setup.md, раздел 4) ---
APP_URL=https://tvoy-orakul.ru
NEXT_PUBLIC_SITE_URL=https://tvoy-orakul.ru
DATABASE_URL=postgres://oracle:<пароль из .db_password>@db:5432/oracle
SESSION_SECRET=<openssl rand -hex 32>
GHCR_OWNER=olya88lagun-coder
NODE_ENV=production

# --- вписывает владелица сама ---
VK_CLIENT_ID=<ID приложения VK ID «Твой оракул»>

# --- платные разборы (план 2б). Пока продажи не включены: PAYMENTS=off, PAID_REPORTS=off ---
PAYMENTS=off
PAID_REPORTS=off
# YOOKASSA_SHOP_ID=<shopId магазина ЮKassa>
# YOOKASSA_SECRET_KEY=<секретный ключ магазина>

# --- воркер: подготовка текста разбора. Без GigaChat разбор собирается из текстов арканов ---
AI_PROVIDER=none
# AI_PROVIDER=gigachat
# GIGACHAT_AUTH_KEY=<ключ авторизации из личного кабинета GigaChat API>
# GIGACHAT_MODEL=GigaChat
# NODE_EXTRA_CA_CERTS=/certs/russian_trusted_root_ca.pem
