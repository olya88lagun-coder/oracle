DATABASE_URL=postgres://oracle:<пароль из .db_password>@db:5432/oracle
SESSION_SECRET=<openssl rand -hex 32>
GHCR_OWNER=olya88lagun-coder
NODE_ENV=production

# --- вписывает владелица сама ---
VK_CLIENT_ID=<ID приложения VK ID «Твой оракул»>
